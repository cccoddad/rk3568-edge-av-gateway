{
  "schema_version": 1,
  "runtime": {
    "mode": "mock",
    "log_level": "info",
    "shutdown_timeout_ms": 10000,
    "run_duration_seconds": 5
  },
  "video": {
    "backend": "mock",
    "width": 320,
    "height": 180,
    "fps": 30,
    "format": "RGB888",
    "queue_capacity": 4,
    "overflow_policy": "drop_oldest",
    "pattern": "moving_box",
    "realtime": true
  },
  "audio": {
    "backend": "mock",
    "sample_rate": 48000,
    "channels": 2,
    "format": "S16_LE",
    "frame_duration_ms": 20,
    "queue_capacity_ms": 300,
    "signal": "sine",
    "frequency_hz": 1000.0,
    "amplitude": 0.25,
    "realtime": true
  },
  "inference": {
    "backend": "mock",
    "mode": "synthetic_target",
    "input_width": 320,
    "input_height": 320,
    "latency_ms": 20,
    "queue_capacity": 1,
    "overflow_policy": "keep_latest",
    "max_result_age_ms": 200
  },
  "video_encoder": {
    "backend": "ffmpeg",
    "codec_name": "libx264",
    "bitrate_bps": 1000000,
    "gop_size": 30,
    "preset": "veryfast"
  },
  "audio_encoder": {
    "backend": "ffmpeg",
    "codec_name": "aac",
    "bitrate_bps": 128000
  },
  "outputs": [
    {
      "type": "mp4",
      "enabled": true,
      "required": true,
      "validate_timestamps": true,
      "path": "out/software-baseline.mp4",
      "queue_capacity": 256,
      "overflow_policy": "block_producer",
      "push_timeout_ms": 1000
    }
  ],
  "monitoring": {
    "metrics_interval_ms": 1000,
    "health_interval_ms": 500,
    "worker_stall_timeout_ms": 3000
  }
}
